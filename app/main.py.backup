from app.quarantine import quarantine_invalid_shipments
from pathlib import Path
from datetime import datetime, timezone
import json
import logging
import time

import pandas as pd
from fastapi import FastAPI, HTTPException, Query, Request
from fastapi.responses import JSONResponse

from app.dq import run_checks

PROJECT = Path(__file__).resolve().parent.parent
DATA_FILE = PROJECT / "data" / "curated" / "curated_shipments.csv"
MODEL_FILE = PROJECT / "models" / "delay_model.joblib"

import sqlite3

DB_FILE = Path("/content/quarantine_guard.db")

def get_db_connection():
    conn = sqlite3.connect(DB_FILE, timeout=10)
    conn.row_factory = sqlite3.Row
    return conn


logging.basicConfig(level=logging.INFO, format="%(message)s")
logger = logging.getLogger("supply_chain_api")

app = FastAPI(
    title="Supply Chain Intelligence Mini-Platform",
    version="1.0.0",
    description="Shipment lookup, route analytics, data quality, and delay prediction."
)

def load_shipments():
    if not DATA_FILE.exists():
        raise RuntimeError(f"Curated dataset not found: {DATA_FILE}")
    df = pd.read_csv(DATA_FILE)
    for col in ["planned_arrival", "actual_arrival"]:
        if col in df.columns:
            df[col] = pd.to_datetime(df[col], errors="coerce", utc=True)
    return df

def json_safe(value):
    if value is None:
        return None
    try:
        if pd.isna(value):
            return None
    except (TypeError, ValueError):
        pass
    if isinstance(value, (pd.Timestamp, datetime)):
        return value.isoformat()
    if hasattr(value, "item"):
        return value.item()
    return value

def row_to_dict(row):
    return {str(k): json_safe(v) for k, v in row.items()}

@app.middleware("http")
async def log_requests(request: Request, call_next):
    start = time.perf_counter()
    status_code = 500
    try:
        response = await call_next(request)
        status_code = response.status_code
        return response
    finally:
        logger.info(json.dumps({
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "method": request.method,
            "path": request.url.path,
            "status_code": status_code,
            "latency_ms": round((time.perf_counter() - start) * 1000, 2)
        }))

@app.exception_handler(HTTPException)
async def http_error_handler(request: Request, exc: HTTPException):
    return JSONResponse(
        status_code=exc.status_code,
        content={"error": {
            "code": exc.status_code,
            "message": str(exc.detail),
            "path": request.url.path
        }}
    )

@app.exception_handler(Exception)
async def unexpected_error_handler(request: Request, exc: Exception):
    logger.exception("Unhandled API error")
    return JSONResponse(
        status_code=500,
        content={"error": {
            "code": 500,
            "message": "Internal server error",
            "path": request.url.path
        }}
    )

@app.get("/health")
def health():
    return {"status": "healthy", "service": "Supply Chain Intelligence API",
            "version": app.version}

@app.get("/shipments/{shipment_id}")
def get_shipment(shipment_id: str):
    df = load_shipments()
    if "shipment_id" not in df.columns:
        raise HTTPException(500, "Curated data is missing shipment_id")
    matches = df[df["shipment_id"].astype(str) == shipment_id]
    if matches.empty:
        raise HTTPException(404, f"Shipment '{shipment_id}' not found")
    return row_to_dict(matches.iloc[0])

@app.get("/shipments")
def list_shipments(
    origin: str | None = None,
    destination: str | None = None,
    status: str | None = None,
    start_date: datetime | None = None,
    end_date: datetime | None = None,
    page: int = Query(1, ge=1),
    page_size: int = Query(20, ge=1, le=200)
):
    df = load_shipments()

    if origin and "origin_port" in df:
        df = df[df["origin_port"].astype(str).str.upper() == origin.upper()]
    if destination and "destination_port" in df:
        df = df[df["destination_port"].astype(str).str.upper() == destination.upper()]
    if status and "status" in df:
        df = df[df["status"].astype(str).str.upper() == status.upper()]

    if start_date:
        if "planned_arrival" not in df:
            raise HTTPException(400, "Date filtering is unavailable: planned_arrival missing")
        start = pd.Timestamp(start_date)
        start = start.tz_localize("UTC") if start.tzinfo is None else start.tz_convert("UTC")
        df = df[df["planned_arrival"] >= start]
    if end_date:
        if "planned_arrival" not in df:
            raise HTTPException(400, "Date filtering is unavailable: planned_arrival missing")
        end = pd.Timestamp(end_date)
        end = end.tz_localize("UTC") if end.tzinfo is None else end.tz_convert("UTC")
        df = df[df["planned_arrival"] <= end]

    total = len(df)
    offset = (page - 1) * page_size
    rows = [row_to_dict(row) for _, row in df.iloc[offset:offset + page_size].iterrows()]
    return {"items": rows, "page": page, "page_size": page_size,
            "total": total, "pages": (total + page_size - 1) // page_size}

@app.get("/routes/{origin}/{destination}/stats")
def route_stats(origin: str, destination: str):
    df = load_shipments()
    required = {"origin_port", "destination_port", "actual_delay_hours", "on_time_flag"}
    missing = required - set(df.columns)
    if missing:
        raise HTTPException(500, f"Curated data missing required columns: {sorted(missing)}")

    route = df[
        (df["origin_port"].astype(str).str.upper() == origin.upper()) &
        (df["destination_port"].astype(str).str.upper() == destination.upper())
    ]
    if route.empty:
        return {"origin": origin, "destination": destination,
                "shipment_count": 0, "avg_delay_hours": None, "on_time_rate": None}

    delays = pd.to_numeric(route["actual_delay_hours"], errors="coerce")
    on_time = route["on_time_flag"].astype("boolean")
    return {
        "origin": origin,
        "destination": destination,
        "shipment_count": int(len(route)),
        "avg_delay_hours": round(float(delays.mean()), 2) if delays.notna().any() else None,
        "on_time_rate": round(float(on_time.mean()), 4) if on_time.notna().any() else None
    }

@app.get("/data-quality/report")
def data_quality_report():
    report_path = PROJECT / "reports" / "data_quality_report.json"
    if report_path.exists():
        return json.loads(report_path.read_text())
    # Generate a fresh report if the saved report is missing.
    return run_checks()

@app.post("/predict-delay")
def predict_delay(payload: dict):
    shipment_id = payload.get("shipment_id")
    if not shipment_id:
        raise HTTPException(422, "Request must include shipment_id")

    if not MODEL_FILE.exists():
        raise HTTPException(503, "Delay model is not trained or saved yet")

    import joblib
    model = joblib.load(MODEL_FILE)
    df = load_shipments()
    matches = df[df["shipment_id"].astype(str) == str(shipment_id)]
    if matches.empty:
        raise HTTPException(404, f"Shipment '{shipment_id}' not found")

    # The model pipeline must define its own booking-time feature columns.
    features = getattr(model, "feature_columns", None)
    if not features:
        raise HTTPException(500, "Saved model is missing feature_columns metadata")

    missing = [col for col in features if col not in matches.columns]
    if missing:
        raise HTTPException(500, f"Model features missing from shipment: {missing}")

    prediction = int(model.predict(matches[list(features)])[0])
    probability = None
    if hasattr(model, "predict_proba"):
        probability = float(model.predict_proba(matches[list(features)])[0][1])

    return {
        "shipment_id": str(shipment_id),
        "predicted_more_than_24h_late": bool(prediction),
        "probability_more_than_24h_late": round(probability, 4) if probability is not None else None,
        "model_version": "1.0.0"
    }


@app.post("/incidents")
def create_incident(payload: dict):
    pipeline_name = str(payload.get("pipeline_name", "")).strip()
    stage = str(payload.get("stage", "")).strip()
    error_message = str(payload.get("error_message", "")).strip()
    status = str(payload.get("status", "open")).strip() or "open"

    if not pipeline_name or not stage or not error_message:
        raise HTTPException(
            status_code=422,
            detail="pipeline_name, stage, and error_message are required"
        )

    created_at = datetime.now(timezone.utc).isoformat()

    with get_db_connection() as conn:
        cursor = conn.execute(
            """
            INSERT INTO incidents
                (pipeline_name, stage, error_message, status, created_at)
            VALUES (?, ?, ?, ?, ?)
            """,
            (pipeline_name, stage, error_message, status, created_at)
        )
        incident_id = cursor.lastrowid

    return {
        "id": incident_id,
        "pipeline_name": pipeline_name,
        "stage": stage,
        "status": status,
        "created_at": created_at
    }


@app.post("/quarantine/run")
def run_quarantine():
    try:
        result = quarantine_invalid_shipments()
        return {
            "message": "Quarantine check completed",
            **result
        }
    except Exception as exc:
        logging.exception("Quarantine run failed")
        raise HTTPException(
            status_code=500,
            detail="Quarantine run failed"
        ) from exc

